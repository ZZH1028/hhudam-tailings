{
  "name": "hhudam-tailings",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/engineering", "/engineering/", "/auth/*", "/api/*", "/ai-gw/*", "/disaster-gw/*", "/emergency-api/*"]
  }
}
